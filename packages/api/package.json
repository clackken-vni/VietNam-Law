{
  "name": "@vietlex/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --dts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@vietlex/shared": "workspace:*",
    "@prisma/client": "^5.14.0",
    "express": "^4.19.0",
    "meilisearch": "^0.39.0",
    "zod": "^3.23.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "prisma": "^5.14.0",
    "tsup": "^8.1.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.0"
  }
}
